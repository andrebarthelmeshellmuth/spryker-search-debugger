{# @var data.tiers array<array{key: string, labelKey: string, boost: int, rows: array<array{labelKeys: array<string>, matched: bool, highlightedHtml: string|null, element: string|null, matches: array<array{token: string, startOffset: int, endOffset: int}>}>}> #}

{% extends template('page-blank') %}

{% define data = {
    productTitle: _view.productTitle,
    productSku: _view.productSku,
    token: _view.token,
    tiers: _view.tiers,
    title: 'search_debug.token_source.heading' | trans({'%token%': _view.token}),
} %}

{% block body %}
    <div class="container token-source-page">
        <h1>{{ 'search_debug.token_source.heading' | trans({'%token%': data.token}) }}</h1>
        {# Two lines rather than one "Product: X (SKU Y)" line — the SKU reads as its own labeled fact
           on its own line, not a parenthetical aside tacked onto the product name. #}
        <p class="text-small">
            {{ 'search_debug.token_source.subheading_name' | trans({'%title%': data.productTitle}) }}<br>
            {{ 'search_debug.token_source.subheading_sku' | trans({'%sku%': data.productSku}) }}
        </p>

        {# Rows are driven by the product's REAL indexed document: one row per identified source value
           present in that tier's array — including product attributes, labeled by their own attribute
           key — plus one row per element no known source claims ("other indexed value"). A source has no
           row only when it truly contributed nothing. When two or more sources contribute the SAME text
           in the same tier, that's genuinely indistinguishable once merged — rather than guessing, the
           row lists every colliding source's label (row.labelKeys has more than one entry) instead of
           picking one. #}
        {% for tier in data.tiers %}
            <section class="token-source-tier">
                {# %field% is only used by the generic fallback label (an ES field a shop's config
                   doesn't have a translation key for) — harmless to pass unconditionally to the two
                   well-known tiers' translations, which simply don't reference it. #}
                <h2 class="token-source-tier__heading">{{ tier.labelKey | trans({'%boost%': tier.boost, '%field%': tier.key}) }}</h2>

                <div class="token-source-tier__body">
                    {% for row in tier.rows %}
                        {% set isAmbiguous = row.labelKeys | length > 1 %}

                        <div class="token-source-field {{ row.matched ? 'token-source-field--matched' : 'token-source-field--unmatched' }} {{ isAmbiguous ? 'token-source-field--ambiguous' : '' }}">
                            <div class="token-source-field__label" title="{{ isAmbiguous ? ('search_debug.token_source.field.ambiguous_hint' | trans) : '' }}">
                                {{ row.labelKeys | map(labelKey => labelKey | trans) | join(' / ') }}
                                {#- An unattributed value is the one case on this page an adopter can act
                                    on: nothing named it, which almost always means a project-specific map
                                    expander contributed it. The hint is rendered as a visible affordance
                                    rather than a bare `title` (like the ambiguity hint above) precisely
                                    because nobody hovers text that gives no sign of being hoverable. -#}
                                {%- if row.isUnattributed | default(false) -%}
                                    <span class="token-source-field__hint"
                                          role="note"
                                          tabindex="0"
                                          aria-label="{{ 'search_debug.token_source.field.other_hint' | trans }}"
                                          data-tooltip="{{ 'search_debug.token_source.field.other_hint' | trans }}">?</span>
                                {%- endif -%}
                            </div>
                            <div class="token-source-field__value">{%- if row.highlightedHtml is not null -%}
                                {%- if row.matched and row.element is not null and row.matches is not empty -%}
                                    {# The analysis-path link is injected right after EACH match's own `</mark>`,
                                       built from THAT match's own offsets — not a shared token-text lookup —
                                       so clicking the glass icon next to one specific highlighted occurrence
                                       (e.g. an edge-ngram prefix match like "switching" vs. the literal word
                                       "switch" elsewhere in the same text) opens the analysis path for THAT
                                       occurrence specifically. A shared token-text-only link would instead
                                       always resolve to whichever occurrence happens to come first in the
                                       document — a different, possibly unrelated word to the one actually
                                       clicked, since two occurrences of the "same" matched token can trace
                                       back to genuinely different origin words. Not passed into TokenHighlighter
                                       itself — that class stays a pure, storage-free string transform with no
                                       URL/routing/translation concerns of its own. `</mark>` is a safe anchor to
                                       `split()` on: TokenHighlighter escapes every non-mark fragment, so the
                                       literal (unescaped) substring `</mark>` can only ever come from
                                       TokenHighlighter's own template, never from product text — splitting on it
                                       yields exactly `row.matches|length + 1` segments, one link rebuilt after
                                       each of the first N, matching each mark to its own match by position.

                                       One line per emitted fragment, deliberately: the whole thing is later
                                       injected into a `white-space: pre-line` value box — a multi-line tag
                                       here would render as stray visible line breaks right after the mark. #}
                                    {%- for segment in row.highlightedHtml | split('</mark>') -%}
                                        {{- segment | raw -}}
                                        {%- if not loop.last -%}
                                            {%- set match = row.matches[loop.index0] -%}
                                            </mark><a href="{{ url('search-debug/token-analysis', { text: row.element, token: data.token, startOffset: match.startOffset, endOffset: match.endOffset }) }}" target="_blank" rel="noopener noreferrer" class="token-source-mark__analysis-link" title="{{ 'search_debug.token_analysis.open' | trans }}">{% include atom('icon') with { data: { name: 'search' } } only %}</a>
                                        {%- endif -%}
                                    {%- endfor -%}
                                {%- else -%}
                                    {{- row.highlightedHtml | raw -}}
                                {%- endif -%}
                            {%- else -%}
                                <span class="token-source-field__no-match">{{ 'search_debug.token_source.no_match' | trans }}</span>
                            {%- endif -%}</div>
                        </div>
                    {% else %}
                        <p class="token-source-field__no-match">{{ 'search_debug.token_source.document_missing' | trans }}</p>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            {# No tiers at all: the fields this search actually used couldn't be determined (a hand-typed
               URL, or a link generated before a search went through the debug-enabled query path) — there
               is no fallback field list to guess with, so say so plainly rather than showing nothing. #}
            <p class="token-source-field__no-match">{{ 'search_debug.token_source.fields_unknown' | trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
