parameters:
    level: 8

    # Resolves relative to a host shop's vendor/spryker-community/search-debug/ install path — this
    # package's own DependencyProviders use the shop's generated Locator and Generated\Shared\Transfer\*
    # classes, which don't exist outside a host shop (see README, "Testing and CI").
    bootstrapFiles:
        - '%rootDir%/../../../phpstan-bootstrap.php'

    # TokenHighlighter(Interface) trips a PHPStan/BetterReflection internal error ("Interface ... not
    # found") isolated to this one class pair, reproducible at every level including 6 — root cause is
    # Spryker core's own shared phpstan-bootstrap.php manually loading PHP_CodeSniffer's custom
    # autoloader, which conflicts with BetterReflection's reflection of this specific class. Every other
    # interface in the package resolves fine cross-file; not a defect in this file. Tracked for a real
    # fix in v1.0.3 (see search-debug-v103-todo memory / README backlog).
    excludePaths:
        - src/SprykerCommunity/Yves/SearchDebugWidget/Resolver/TokenHighlighter.php
        - src/SprykerCommunity/Yves/SearchDebugWidget/SearchDebugWidgetFactory.php

    ignoreErrors:
        -
            # Spryker\Yves\Kernel\Controller\AbstractController::getApplication() itself declares this
            # union return type, and core's own getRouter()/getRequestStack()/getLocale() call ->get() on
            # it exactly as unguarded as this — Application (Silex/Pimple-based) does have get() at
            # runtime, PHPStan just can't see it declared across the union. Matches the accepted core
            # idiom, not a bug here.
            message: '#Call to an undefined method Spryker\\Service\\Container\\ContainerInterface\|Spryker\\Yves\\Kernel\\Application::get\(\)\.#'
            path: src/SprykerCommunity/Yves/SearchDebugWidget/Controller/CheckInstallationController.php
            count: 1
